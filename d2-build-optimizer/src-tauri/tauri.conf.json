{
  "$schema": "https://schema.tauri.app/config/2/schema.json",
  "productName": "D2 Build Optimizer",
  "version": "0.1.0",
  "identifier": "de.apexshd.d2buildoptimizer",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "D2 Build Optimizer",
        "label": "main",
        "width": 1280,
        "height": 720,
        "minWidth": 1280,
        "minHeight": 720,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": ["icons/icon.ico"],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    },
    "longDescription": "D2 Build Optimizer for Windows - Fan-Tool fuer The Division 2 Builds",
    "shortDescription": "D2 Build Optimizer"
  }
}
